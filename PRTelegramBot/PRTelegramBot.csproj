<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <Authors>Ilya Samarin</Authors>
    <Company />
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/prethink/PRTelegramBot</RepositoryUrl>
    <PackageTags>Telegram, TelegramBot</PackageTags>
    <Description>A .NET framework for building Telegram bots on top of Telegram.Bot: attribute-based command routing, menus, middleware, DI and background tasks</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>PRTelegramBot</Title>
    <PackageIcon>LogoBot.png</PackageIcon>
    <NeutralLanguage>en-US</NeutralLanguage>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://prethink.gitbook.io/prtelegrambot/</PackageProjectUrl>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Source Link: lets consumers step into this library's source from their debugger,
         and is required by the .NET Foundation eligibility criteria. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Debug symbols travel inside the package, so no separate symbol server is needed. -->
    <DebugType>embedded</DebugType>

    <!-- Reproducible builds: normalises source paths so a CI build does not embed local ones. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>


  <ItemGroup>
    <!-- The test project needs the internal members: the cache and the step handlers are
         keyed through internal helpers that link an update to its bot. -->
    <InternalsVisibleTo Include="PRTelegramBot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- LICENSE and the icon are taken from the repository root, so there is a single source of truth. -->
    <None Include="../LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="../LogoBot.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.txt">
      <Pack>true</Pack>
      <PackagePath>build</PackagePath>
    </None>
    <None Include="PRTelegramBot.targets">
      <Pack>true</Pack>
      <PackagePath>build</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.17" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.17" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.17" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.17" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.17" />
    <PackageReference Include="Telegram.Bot" Version="22.10.2.1" />
    <PackageReference Include="ToonNet" Version="1.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The package README is the repository root README.md (English), so there is a single source of truth. -->
    <None Include="../README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>
